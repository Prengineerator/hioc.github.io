# Supabase project URL and public anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-side only, NEVER prefix with NEXT_PUBLIC_ and never
# import into client components. Used for privileged writes (e.g. creating orders).
SUPABASE_SERVICE_ROLE_KEY=

# --- Public site base URL. Used to build ABSOLUTE links in customer messages
# (e.g. the order-tracking link in WhatsApp). Set to your live domain, no
# trailing slash. On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL. ---
# NEXT_PUBLIC_SITE_URL=https://hioc.in

# --- Notifications (F4). Leave unset to use the built-in log adapter, which
# records deliveries in the notifications table without sending anything. ---
# NOTIFY_PROVIDER=log            # log | whatsapp | sms
# WhatsApp (Meta Cloud API):
# WHATSAPP_TOKEN=          # permanent System-User token
# WHATSAPP_PHONE_ID=       # the Phone number ID (NOT the WABA/App ID)
# WHATSAPP_API_VERSION=v21.0
# Approved template names (defaults shown; override if you named them differently):
# WHATSAPP_TPL_ACCEPTED=order_accepted
# WHATSAPP_TPL_READY=order_ready
# WHATSAPP_TPL_REJECTED=order_rejected
# WHATSAPP_TPL_CANCELLED=order_cancelled
# E-bill over WhatsApp (RCT-1): set to your approved template name to turn the
# WhatsApp bill channel ON. Leave UNSET to keep it off (email-only e-bill).
# WHATSAPP_TPL_BILL=order_bill_1
# Optional logo/image on the WhatsApp bill: set ONLY if your approved bill
# template was created with an IMAGE header (Meta rejects the send otherwise).
# Value = a public HTTPS URL Meta can fetch, e.g. your deployed logo:
# WHATSAPP_TPL_BILL_HEADER_IMAGE=https://your-domain/images/logo-black.png
# WHATSAPP_TPL_LANG=en
#
# WhatsApp Business Account ID — Meta App > WhatsApp > API Setup, or Business
# Settings > Accounts > WhatsApp Accounts. NOT the Phone number ID and NOT the
# App ID. Only `npm run verify:notifications` uses it, and it is what lets that
# script ask Meta whether the bill template is APPROVED and categorised UTILITY
# rather than MARKETING — the single most likely cause of "the bill never
# arrives". Without it that check cannot run and the script says so.
# WHATSAPP_WABA_ID=
# Meta identifies a template by NAME + LANGUAGE. A mismatch is rejected with
# `(#132001) Template name does not exist in the translation` — which reads like
# a wrong NAME when the name is fine and only the language differs.
#
# Templates get created months apart, so their languages drift: choosing
# "English" in the WhatsApp Manager UI gives `en`, "English (US)" gives `en_US`.
# WHATSAPP_TPL_LANG is the default for every template; set a per-event override
# only where one template's language differs from the rest. This is not
# hypothetical — production had order_ready_1 on `en` and order_bill_1 on
# another code, so every status message sent and every bill was rejected.
# WHATSAPP_TPL_LANG=en
# WHATSAPP_TPL_BILL_LANG=en_US
# WHATSAPP_TPL_ACCEPTED_LANG=
# WHATSAPP_TPL_READY_LANG=
# WHATSAPP_TPL_REJECTED_LANG=
# WHATSAPP_TPL_CANCELLED_LANG=

#
# --- Delivery/read receipts (WA-4). Callback URL is /api/webhooks/whatsapp ---
# (/api/whatsapp/webhook still answers, as the same handler, for the older
#  configuration — but point Meta at /api/webhooks/whatsapp and retire it.)
#
# BOTH of these are REQUIRED for receipts. The endpoint fails CLOSED: with
# WHATSAPP_APP_SECRET unset every status callback is rejected with 401 and every
# handshake with 403, so receipts silently never arrive and Meta eventually
# disables the subscription. This is deliberate — the alternative is an
# unauthenticated public write endpoint into the delivery log — but it means
# "unset" is not a working configuration, it is a disabled feature.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=   # you pick this; paste the SAME value into Meta's "Verify token"
# WHATSAPP_APP_SECRET=             # App settings > Basic > App Secret (REQUIRED for the webhook)
# Login OTP over WhatsApp (Supabase "Send SMS Hook" → /api/auth/sms-hook):
# WHATSAPP_OTP_TEMPLATE=login_code # your approved Authentication template name
# SUPABASE_SEND_SMS_HOOK_SECRET=   # the secret Supabase shows when you enable the Send SMS Hook (v1,whsec_...)
# SMS (Twilio):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...

# --- E-bill by email (RCT-2). When a customer gives an email at checkout, we
# send them a link to their bill page (/order/<id>/receipt) via Resend. Leave
# unset to disable email delivery (order placement is unaffected). ---
# RESEND_API_KEY=re_...          # Resend API key
# RESEND_FROM=HIOC <bills@hioc.in>   # verified sender (domain verified in Resend)

# --- Error monitoring (F5t). Optional HTTP collector for captured errors
# (Sentry tunnel / Slack webhook / Logtail). Unset = console-only. ---
# MONITORING_WEBHOOK_URL=

# --- Vercel Cron secret (H5). Set this to a long random string in the Vercel
# project's Environment Variables. Vercel automatically sends it as
# `Authorization: Bearer <CRON_SECRET>` on cron invocations of
# /api/cron/expire-orders (configured in vercel.json), which the route checks.
# CRON_SECRET=

# --- Feature flags (XC-045), all default ON. Set to false to disable. ---
# NEXT_PUBLIC_FLAG_OWNER_DASHBOARD=true
# NEXT_PUBLIC_FLAG_REALTIME=true
# FLAG_NOTIFICATIONS=true
# Staff POS-lite order entry (POS-1) — the counter-tablet "New order" screen.
# Default ON; set to false to hide the nav tab and dark the /staff/orders/new
# surface (it then renders a "not enabled" state).
# NEXT_PUBLIC_FLAG_STAFF_POS=true
# Table-QR scan-to-order (QR-1) — the /t/<qr_token> customer surface where a
# seated diner scans the table QR and orders in dine-in context (pays online
# first, D6). Default OFF (dark-launched): while off, /t/<token> shows a friendly
# "ask staff" screen and nothing else. Set to true once tables + QR cards (QR-2)
# and the online-payment path are verified in the cafe.
# NEXT_PUBLIC_FLAG_TABLE_QR=false
# Require guests (not logged in) to verify their mobile via a WhatsApp OTP at
# checkout. OFF by default — only enable once Supabase phone-OTP + the Send-SMS
# (WhatsApp) hook are configured, or guest checkout will break.
# NEXT_PUBLIC_FLAG_GUEST_OTP=false
# Staff attendance (Phase 5) — geofenced clock in/out at /staff/attendance, the
# owner sheet at /owner/attendance, plus the geofence + pay-rules panel in owner
# Settings and the salary section on the Team page. Turning this ON reveals all
# of those at once; turning it off hides them again without losing any data.
# Default OFF. Two things must be true before it goes on IN PRODUCTION:
#   1. supabase/2026-08-attendance.sql and 2026-08-attendance-day-marks.sql are
#      applied (check with `npm run verify:db`);
#   2. the cafe's coordinates are set from a reading taken AT the counter, and
#      the radius/accuracy tuned to what a phone actually reports there. An
#      untuned fence refuses honest staff, and a feature that refuses honest
#      staff on day one does not get a second chance with the team.
# Until the coordinates are set the screens render but punching stays disabled,
# which is the correct behaviour — there is no safe default for "where is the cafe".
# NEXT_PUBLIC_FLAG_ATTENDANCE=false

# --- Payments (FND-1/PAY-1..3) — Razorpay, called via REST (no SDK dep). ---
# Leave ALL of these unset to disable online payment entirely: checkout falls
# back to "Pay at counter" only, and the online-payment UI is hidden.
# Server-side key pair (Basic auth for Orders/Refunds API calls):
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# HMAC secret configured on the Razorpay webhook (Dashboard > Webhooks),
# pointed at POST /api/payments/webhook:
# RAZORPAY_WEBHOOK_SECRET=
# Public key id handed to the client-side checkout.js widget — safe to
# expose to the browser (usually the same value as RAZORPAY_KEY_ID):
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Suggestion engine (Phase 7, docs/PHASE-7-SUGGESTION-ENGINE-SPEC.md) ---
# Anthropic API key — SERVER-ONLY (never NEXT_PUBLIC_). Leave this, Jev's
# TYPESAFE_API_KEY below and GEMINI_API_KEY below all unset and the engine
# still works on its deterministic ranker (source: 'fallback').
# ANTHROPIC_API_KEY=
#
# --- Preferred for decisions: Jev (TypeSafe AI) -----------------------------
# TypeSafe AI's "Jev" is a decision-only "System One" model: fast (70-500ms),
# cheap ($0.042 per million INPUT tokens, output free), and it's what picks
# the final 3 suggestions and tags menu traits when configured — the
# DECIDER role only (§1). Jev cannot write prose, so it is NEVER used for the
# weekly owner digest (that stays on Anthropic or Gemini below). Currently
# early access — join the waitlist at https://typesafe.ai.
# TYPESAFE_API_KEY=          # SERVER-ONLY, never NEXT_PUBLIC_
# Optional: override Jev's model id. Unset = the SDK's own default ("jev-latest").
# JEV_MODEL=jev-latest
#
# --- Free option: Gemini ---------------------------------------------------
# No Anthropic billing? Google's Gemini API has a free tier that's enough to
# run this engine. Get a key at https://aistudio.google.com/apikey (no card
# required for the free tier) and set it here — SERVER-ONLY, never
# NEXT_PUBLIC_. With ANTHROPIC_API_KEY unset and this set, the engine runs
# entirely on Gemini at $0.
# GEMINI_API_KEY=
# Free-tier model ids change more often than Anthropic's paid ones — if the
# default below ever 404s or 400s, open https://aistudio.google.com/apikey,
# copy the EXACT model id shown for your key, and paste it here.
# GEMINI_MODEL=gemini-3-flash-preview
# Optional: a different (or cheaper/faster) Gemini model just for the weekly
# owner digest. Unset = reuse GEMINI_MODEL for everything.
# GEMINI_WORKER_MODEL=
# Which provider answers DECISION jobs (choosing picks, tagging traits):
# 'auto' (default) prefers Jev when TYPESAFE_API_KEY is set, else Anthropic
# when ANTHROPIC_API_KEY is set, else Gemini; 'jev', 'anthropic' or 'gemini'
# pins one explicitly (and is a no-op — same as no provider — if that
# provider's key isn't set). The weekly digest (which needs prose) ALWAYS
# uses Anthropic or Gemini regardless of this setting — Jev can't write text,
# so a 'jev' pin falls through to Anthropic/Gemini for the digest only.
# SUGGEST_LLM_PROVIDER=auto
# NOTE: on Google's UNPAID (free) tier, prompts and responses may be used by
# Google to improve their products (see the Gemini API's terms for the free
# tier). We send it no personal data either way — only the menu/trait catalog
# and anonymous preference signals (mood, chips, a coarse taste-profile
# summary); see §5.4/§9 of the Phase-7 spec. If that's not acceptable for your
# deployment, use ANTHROPIC_API_KEY (paid, no such training use) instead.
#
# Decisions (trait tagging, choosing picks) → the decider model; execution
# (weekly digest) → the worker model. Anthropic ids shown; ignored while
# Gemini is the active provider.
# SUGGEST_DECIDER_MODEL=claude-opus-5
# SUGGEST_WORKER_MODEL=claude-sonnet-5
# Daily LLM spend cap in USD (DB-backed, IST day). At the cap → deterministic
# only. Gemini's free tier always costs $0, so this only ever limits Anthropic
# spend.
# SUGGEST_DAILY_BUDGET_USD=3
# Kill switch: off = never call any LLM (Jev, Anthropic or Gemini), deterministic
# suggestions only.
# SUGGEST_LLM=on
