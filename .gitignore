# Next.js
/.next/
/out/

# Dependencies
/node_modules/

# Environment variables
.env
.env.local
.env*.local

# Build / debug
/build
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo

# Vercel
.vercel

# macOS
.DS_Store
.env*

# Credential scratch files. These live in the repo root during setup and are
# NOT ignored by the .env* rules above, so a routine `git add -A` would commit
# them straight to a public remote. razorpay_testkey.txt was sitting untracked
# and unignored when this was added.
*key*.txt
*secret*.txt
*credentials*.txt

# Desktop shell (Phase 7)
/desktop/node_modules/
/desktop/dist/
/desktop/release/

# Petpooja history import (scripts/import-petpooja.ts). These are the owner's
# raw POS export and its dry-run report at the repo root — the exports hold
# real customer names, phone numbers and addresses, and must never be
# committed. Anchored with a leading `/` so this only ignores the repo root,
# not an unrelated .xlsx/.csv/.md living elsewhere in the tree.
/petpooja-*.md
/*.xlsx
/*.csv
